/* ==========================================================================
   model-launcher dashboard stylesheet
   ==========================================================================
   Layout only. The dashboard regions are drawn cell by cell in draw.py with the
   design tokens from theme.py, so colours live there, not here. The overlays
   (tui/overlays.py) and the hosts screen (tui/hosts.py) are drawn the same
   way; this file only lays the regions out.
   ========================================================================== */

Screen {
    layers: base overlay;
    background: $background;
}
/* Overlays show the dashboard through; they dim it themselves (Tokens.dim). */
Overlay {
    background: transparent;
}

#band, #context, #summary { height: 1; }
#card { margin-bottom: 1; }
#summary { margin-bottom: 1; }
#table {
    height: 1fr;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-color: $panel;
    scrollbar-color-hover: $primary;
}
#log { display: none; }
#log.visible { display: block; }
/* In the flow, not docked: a docked footer covers the last row of whatever is
   above it (the drawer's bottom border, or the last job in the queue). */
#footer { height: 1; }
